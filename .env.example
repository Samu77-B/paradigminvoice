# Copy to .env for local development (never commit .env)

SECRET_KEY=generate-a-long-random-string
FLASK_DEBUG=true

# Local: omit DATABASE_URL to use SQLite at instance/invoices.db
# Railway: add PostgreSQL in the project; Railway sets DATABASE_URL on this service (reference the variable).
# DATABASE_URL=postgresql://...

# Optional: store generated PDFs on a mounted path (only if you use server-side PDF files)
# DATA_DIR=/data

# Authentication (optional — if unset, the app stays open as before)
# INVOICE_APP_USERNAME=admin
# INVOICE_APP_PASSWORD=your-secure-password

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Invoices <onboarding@resend.dev>

# Company branding (optional — defaults to Paul Banning if unset)
# COMPANY_NAME=Paradigm Studio Ltd
# COMPANY_ADDRESS=Your address line 1\nYour town\nPostcode
# COMPANY_PHONE=01234 567890
# COMPANY_BANK_ACCOUNT_NAME=Paradigm Studio Ltd
# COMPANY_BANK_ACCOUNT=12345678
# COMPANY_BANK_SORT=12-34-56
# COMPANY_PAYMENT_TERMS=Payment is due on receipt of invoice
# COMPANY_APP_TITLE=Invoices & quotes

